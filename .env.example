# ============================================================
# CREDENCIALES DE IQ OPTION
# ============================================================
IQ_EMAIL=tu_correo@example.com
IQ_PASSWORD=tu_contrasena

# ============================================================
# TIPO DE CUENTA: PRACTICE o REAL
# ============================================================
IQ_ACCOUNT=PRACTICE

# ============================================================
# PARES NORMALES Y OTC
# El bot omite temporalmente los que estén cerrados/no disponibles.
# ============================================================
IQ_ASSETS=AUDCAD,AUDCAD-OTC,EURUSD,EURUSD-OTC,GBPUSD,GBPUSD-OTC,EURGBP,EURGBP-OTC,EURJPY,EURJPY-OTC,GBPJPY,GBPJPY-OTC,USDJPY,USDJPY-OTC,AUDUSD,AUDUSD-OTC,NZDUSD,NZDUSD-OTC,USDCAD,USDCAD-OTC

# ============================================================
# CONFIGURACIÓN DE OPERACIONES
# ============================================================
IQ_AMOUNT=1
IQ_TIMEFRAME_MIN=5
IQ_EXPIRATION_MIN=5

# trend o support_channel
IQ_STRATEGY=trend

# false: solo señales | true: ejecuta operaciones
ENABLE_TRADING=false

# ============================================================
# PROTECCIONES PARA CUENTA REAL
# ============================================================
ENABLE_REAL_TRADING=false
REAL_TRADING_CONFIRMATION=
MAX_REAL_AMOUNT=1

# ============================================================
# GESTIÓN DE RIESGO
# Espera mínima por par después de una operación completada.
# ============================================================
MIN_CANDLES_BETWEEN_TRADES=5
MAX_TRADES_DAY=10
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_LOSS=5
